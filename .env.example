# docaudit reads only environment variables; export these in your shell.
# Never commit a real key. .env files are git-ignored.

# Credentials: the Anthropic SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=

# Required for --backend anthropic (or pass --model).
DOCAUDIT_MODEL=claude-opus-5-5

# Optional overrides.
# DOCAUDIT_EFFORT=high                  # one effort for every role (default: per role)
# DOCAUDIT_THINKING=adaptive            # set to off to omit the thinking parameter
# DOCAUDIT_FALLBACKS=default            # server-side refusal fallback; set to off to disable
# DOCAUDIT_PRICE_IN_PER_MTOK=4          # price overrides for the cost cap (USD per million tokens)
# DOCAUDIT_PRICE_OUT_PER_MTOK=20
# DOCAUDIT_PRICE_CACHE_READ_PER_MTOK=0.2
